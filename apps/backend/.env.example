DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is local-only. Production must use PostgreSQL and a runtime role without BYPASSRLS.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# Disabled until explicitly configured. Messages remain unconfigured in the durable outbox.
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
WEBHOOK_SECRET=
