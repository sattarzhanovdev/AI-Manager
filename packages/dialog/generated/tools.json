    "phase": "0",
    "description": "График работы филиала на дату с учётом праздников.",
    "parameters": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  {
    "name": "create_lead",
    "phase": "1a",
    "description": "Создать заявку, когда клиент хочет записаться, заказать, перезвонить или пожаловаться и обязательные поля собраны.",
    "parameters": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "booking",
            "consultation",
            "order",
            "complaint",
            "reschedule",
            "callback",
            "other"
          ]
        },
        "fields": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "service": {
              "type": "string"
            },
            "preferred_time": {
              "type": "string"
            },
            "comment": {
              "type": "string"
            }
          },
          "required": [
            "phone"
          ]
        },
        "priority": {
          "enum": [
            "normal",
            "urgent"
          ]
        }
      },
      "required": [
        "type",
        "fields"
      ]
    }
  },
  {
    "name": "transfer_to_human",
