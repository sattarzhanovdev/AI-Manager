# ─────────────────────────────────────────────────────────────────────────────
# ALL-менеджер — переменные окружения. Реальные значения НЕ коммитятся.
# Локально: cp .env.example apps/web/.env.local и заполните.
# Vercel: Project → Settings → Environment Variables (Production).
# ─────────────────────────────────────────────────────────────────────────────

# Основной источник — django. Режимы совместимости: supabase или mock (только разработка).
DATA_SOURCE=django
# Публичный адрес приложения (Vercel: https://<project>.vercel.app)
APP_URL=http://localhost:3000
# Основной backend этой версии; адрес доступен только серверу Next.js
DJANGO_API_URL=http://127.0.0.1:8000/api/v1
# Метка «Demo Environment» в кабинете: 1 — показывать
DEMO_ENVIRONMENT=1

# Supabase: Project Settings → API
SUPABASE_URL=
# Publishable / anon key — публичный, RLS защищает данные
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — ТОЛЬКО для provisioning-скрипта и доверенных серверных задач.
# Кабинет и AI-диалог работают под JWT пользователя; в Vercel эту переменную можно не задавать.
SUPABASE_SERVICE_ROLE_KEY=

# LLM для AI-ассистента (ключ только на сервере). Без ключа — локальный движок, ответ помечается «ограниченный режим».
# LLM_PROVIDER=anthropic|openai (по умолчанию — тот, чей ключ задан)
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ограничения частоты и расходов AI (атомарно в базе, таблица ai_requests)
AI_RATE_PER_USER_MINUTE=20
AI_RATE_PER_COMPANY_DAY=600
AI_DAILY_TOKEN_BUDGET=400000
AI_MAX_OUTPUT_TOKENS=350

# Provisioning демо-среды (pnpm --filter @all/web provision:demo). Пароли не коммитятся;
# если не заданы — генерируются и печатаются один раз.
DEMO_OWNER_EMAIL=demo.owner@example.com
DEMO_OWNER_PASSWORD=
DEMO_STAFF_EMAIL=demo.staff@example.com
DEMO_STAFF_PASSWORD=

# Mock-вход (код 000000) в production-сборке выключен; включать только для локальной проверки
ALLOW_MOCK_AUTH=0

# ── Не нужны для веб-MVP (голосовой сервис apps/voice, воркеры apps/workers, каналы) ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_PRIMARY=deepgram
STT_FALLBACK=yandex
LLM_PRIMARY=anthropic:claude-haiku-5-5
LLM_FALLBACK=openai:gpt-4.1-mini
TTS_PRIMARY=cartesia
TTS_FALLBACK=yandex
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
YANDEX_API_KEY=
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
# Вебхуки каналов принимают данные только с секретом (в DATA_SOURCE=supabase отключены)
TELEGRAM_WEBHOOK_SECRET=
CHAT_WEBHOOK_SECRET=
SMS_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
